# Pantheon environment variables.
# Copy to .env.local for local dev, or set as GitHub Actions repo variables for prod.
# All vars are OPTIONAL — the site runs fully without any of them.

# ── Privacy-friendly analytics (cookieless, off by default) ──────────────────
# Set the domain to enable Plausible. Leave unset for zero tracking / no
# third-party requests / no consent banner. See src/components/analytics.tsx.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=pantheon.ungetsu.net
# Optional: override the script URL (self-hosted Plausible, or a proxied path).
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
